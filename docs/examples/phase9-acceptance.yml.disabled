# INACTIVE EXAMPLE. Keep outside .github/workflows until separately approved.
# The job is also disabled before scheduling. The proposed group/label must first
# be verified to exclude protected machines BEFORE assignment.
# Target workflow path/identity: .github/workflows/labs-phase9-acceptance.yml on main.
# Requires current controller/host admission, pinned runner with bundled Node24,
# source enrollment and exact plan/acknowledgement before the hook releases steps.
name: Labs Phase9 acceptance
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  build:
    if: ${{ false }}
    runs-on:
      group: vegastack-labs
      labels: vsk-labs-phase9-node01
    timeout-minutes: 20
    permissions:
      contents: read
      id-token: write
    env:
      RUNNER_TOOL_CACHE: /home/runner/_work/_toolcache
      AGENT_TOOLSDIRECTORY: /home/runner/_work/_toolcache
    steps:
      - name: Prepare job-local compiler paths
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          mkdir -p "$RUNNER_TEMP/go-tmp" "$RUNNER_TOOL_CACHE"
          printf 'GOTMPDIR=%s/go-tmp\n' "$RUNNER_TEMP" >> "$GITHUB_ENV"
      - name: Check out exact enrolled source
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          ref: ${{ github.sha }}
          fetch-depth: 0
          persist-credentials: false
      - name: Prepare the pinned compiler
        uses: actions/setup-go@b7ad1dad31e06c5925ef5d2fc7ad053ef454303e # v7.0.0
        with:
          go-version: 1.27.0
          cache: false
      - name: Bind packaging metadata to the admitted numeric job
        shell: bash
        run: |
          set -euo pipefail
          /home/runner/externals/node24/bin/node --input-type=module <<'JS'
          import fs from 'node:fs';
          const env = process.env;
          if (env.GITHUB_REPOSITORY !== 'vegastack/vegastack-labs' || env.GITHUB_REF !== 'refs/heads/main' || env.GITHUB_WORKFLOW_REF !== 'vegastack/vegastack-labs/.github/workflows/labs-phase9-acceptance.yml@refs/heads/main') throw Error('wrong workflow');
          const binding = JSON.parse(fs.readFileSync('/home/runner/.vsk-ci-job.json', 'utf8'));
          const numeric = value => typeof value === 'string' && /^[1-9][0-9]*$/.test(value) && BigInt(value) <= 9223372036854775807n;
          if (!numeric(binding.runId) || !numeric(binding.jobId) || binding.runId !== env.GITHUB_RUN_ID || !Number.isSafeInteger(binding.attempt) || binding.attempt < 1 || String(binding.attempt) !== env.GITHUB_RUN_ATTEMPT || !/^[0-9a-f]{40}$|^[0-9a-f]{64}$/.test(env.GITHUB_SHA)) throw Error('wrong assignment');
          // Metadata is job-writable and grants no authority; the controller independently
          // verifies the actual source/run/attempt/job before publication.
          fs.appendFileSync(env.GITHUB_ENV, `PHASE9_INVOCATION_ID=https://github.com/vegastack/vegastack-labs/actions/runs/${binding.runId}/attempts/${binding.attempt}/jobs/${binding.jobId}\n`);
          JS
      - name: Build and package the public-data application
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          CGO_ENABLED=0 GOOS=linux go build -trimpath -buildvcs=true -o "$RUNNER_TEMP/phase9-app" ./tooling/testdata/phase9-app
          /vsk-ci/vsk-labs release build-go-image \
            --binary "$RUNNER_TEMP/phase9-app" \
            --source-uri https://github.com/vegastack/vegastack-labs \
            --source-revision "$GITHUB_SHA" \
            --builder-id https://github.com/vegastack/vegastack-labs/.github/workflows/labs-phase9-acceptance.yml@refs/heads/main \
            --invocation-id "$PHASE9_INVOCATION_ID" \
            --self-healthcheck \
            --directory "$RUNNER_TEMP/phase9-image" --output json
      - name: Download the checksum-pinned signing tool into this job
        shell: bash
        run: |
          set -euo pipefail
          /home/runner/externals/node24/bin/node --input-type=module <<'JS'
          import fs from 'node:fs';
          import crypto from 'node:crypto';
          import { Transform, Readable } from 'node:stream';
          import { pipeline } from 'node:stream/promises';
          const pins = {
            x64: ['amd64', '4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71'],
            arm64: ['arm64', 'c5d324e091826b0d7a78eb16fef316450b4eb9aaec045611c08ba06f5e73220a']
          };
          const pin = pins[process.arch];
          if (process.platform !== 'linux' || !pin) throw Error('unsupported signing platform');
          let url = new URL(`https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-${pin[0]}`);
          let response;
          for (let count = 0; count < 5; count++) {
            if (url.protocol !== 'https:' || url.username || url.password || !['github.com', 'release-assets.githubusercontent.com', 'objects.githubusercontent.com'].includes(url.hostname)) throw Error('invalid download origin');
            response = await fetch(url, { redirect: 'manual', signal: AbortSignal.timeout(60000) });
            if ([301,302,303,307,308].includes(response.status)) {
              const location = response.headers.get('location');
              await response.body?.cancel();
              if (!location) throw Error('missing redirect');
              url = new URL(location, url); continue;
            }
            break;
          }
          if (!response?.ok || !response.body) throw Error('signing tool download failed');
          const path = `${process.env.RUNNER_TEMP}/cosign`;
          const fd = fs.openSync(path, 'wx', 0o600);
          const hash = crypto.createHash('sha256'); let size = 0;
          const check = new Transform({ transform(chunk, encoding, done) {
            size += chunk.length;
            if (size > 256 * 1024 * 1024) { done(Error('signing tool too large')); return; }
            hash.update(chunk); done(null, chunk);
          }});
          try {
            await pipeline(Readable.fromWeb(response.body), check, fs.createWriteStream(path, { fd, autoClose: true }));
            if (hash.digest('hex') !== pin[1]) throw Error('signing tool checksum mismatch');
            fs.chmodSync(path, 0o700);
          } catch {
            // Only this job-owned download path; never execute a partial/mismatched file.
            fs.rmSync(path, { force: true }); throw Error('signing tool preparation failed');
          }
          JS
      - name: Sign both unchanged statements
        shell: bash
        run: |
          set -euo pipefail
          umask 077
          cd "$RUNNER_TEMP/phase9-image"
          test ! -e provenance.sigstore.json
          test ! -e sbom.sigstore.json
          "$RUNNER_TEMP/cosign" attest-blob --yes --oidc-provider=github-actions --statement provenance.statement.json --bundle provenance.sigstore.json
          "$RUNNER_TEMP/cosign" attest-blob --yes --oidc-provider=github-actions --statement sbom.statement.json --bundle sbom.sigstore.json
      - name: Retain only the public application artifacts for the approved manual handoff
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: labs-phase9-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/phase9-image/
          if-no-files-found: error
          retention-days: 1
          include-hidden-files: false
# There is deliberately no registry credential, publication or deployment step.
# The controller consumes the exact protected artifact handoff and separately
# acknowledged publication/deployment plans. An upload is not trusted acceptance.
