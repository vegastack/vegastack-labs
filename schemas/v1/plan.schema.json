{
  "$defs": {
    "contract-extension": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^x-[a-z][a-z0-9.-]{0,62}$",
          "type": "string"
        },
        "valueDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "name",
        "valueDigest"
      ],
      "type": "object"
    },
    "host-access-probe-step": {
      "additionalProperties": false,
      "properties": {
        "draftDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "kind": {
          "enum": [
            "local-probe",
            "source-probe",
            "collect"
          ],
          "type": "string"
        },
        "operationId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/host-access-probe-step"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "sourceContextDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "sourceHostId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "sourceIdentityDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "specificationDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "operationId",
        "kind",
        "sourceHostId",
        "sourceIdentityDigest",
        "sourceContextDigest",
        "draftDigest",
        "specificationDigest"
      ],
      "type": "object"
    },
    "host-access-sequence": {
      "additionalProperties": false,
      "properties": {
        "applyDraftDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "applyOperationId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "confirmDraftDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "confirmOperationId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "probeSteps": {
          "items": {
            "$ref": "#/$defs/host-access-probe-step"
          },
          "maxItems": 16,
          "type": "array"
        },
        "profileLockDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/host-access-sequence"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "specificationDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "subjectHostId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "subjectIdentityDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "subjectHostId",
        "subjectIdentityDigest",
        "profileLockDigest",
        "applyOperationId",
        "applyDraftDigest",
        "probeSteps",
        "confirmOperationId",
        "confirmDraftDigest",
        "specificationDigest"
      ],
      "type": "object"
    },
    "host-action-console-confirmation": {
      "additionalProperties": false,
      "properties": {
        "hostIdentityDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "method": {
          "enum": [
            "administrator-verified-console"
          ],
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/host-action-console-confirmation"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "targetDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "method",
        "targetDigest",
        "hostIdentityDigest"
      ],
      "type": "object"
    },
    "host-action-credential-confirmation": {
      "additionalProperties": false,
      "properties": {
        "hostIdentityDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "method": {
          "enum": [
            "administrator-verified-console"
          ],
          "type": "string"
        },
        "nativeConsumerMachineId": {
          "pattern": "^[a-f0-9]{32}$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/host-action-credential-confirmation"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "targetDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "targetRevision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "method",
        "targetDigest",
        "hostIdentityDigest",
        "targetRevision",
        "nativeConsumerMachineId"
      ],
      "type": "object"
    },
    "host-action-request": {
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "actionInput": {
          "maxLength": 32768,
          "minLength": 1,
          "type": "string"
        },
        "actionInputDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "actionVersion": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "type": "string"
        },
        "automationPrincipalId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "callerUid": {
          "minimum": 1,
          "type": "integer"
        },
        "consoleConfirmation": {
          "$ref": "#/$defs/host-action-console-confirmation"
        },
        "credentialMaterialVersion": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "credentialReferenceId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "expectedStateRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "hostId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "idempotencyKey": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "recoveryEpoch": {
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/host-action-request"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "targetDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "targetRevision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "actionId",
        "actionVersion",
        "actionInputDigest",
        "actionInput",
        "hostId",
        "targetRevision",
        "targetDigest",
        "automationPrincipalId",
        "callerUid",
        "credentialReferenceId",
        "credentialMaterialVersion",
        "consoleConfirmation",
        "expectedStateRevision",
        "recoveryEpoch",
        "idempotencyKey"
      ],
      "type": "object"
    },
    "host-adoption-request": {
      "additionalProperties": false,
      "properties": {
        "confirmation": {
          "$ref": "#/$defs/host-identity-confirmation"
        },
        "expectedStateRevision": {
          "minimum": 0,
          "type": "integer"
        },
        "hostId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "idempotencyKey": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "observationDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "observationId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "recoveryEpoch": {
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/host-adoption-request"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "hostId",
        "observationId",
        "observationDigest",
        "idempotencyKey",
        "expectedStateRevision",
        "recoveryEpoch",
        "confirmation"
      ],
      "type": "object"
    },
    "host-discovery-console-confirmation": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "administrator-verified-console"
          ],
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/host-discovery-console-confirmation"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "targetDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "targetDigest",
        "method"
      ],
      "type": "object"
    },
    "host-discovery-target": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 45,
          "minLength": 1,
          "type": "string"
        },
        "assetId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": [
            "string",
            "null"
          ]
        },
        "credentialMode": {
          "enum": [
            null,
            "preloaded-discovery"
          ],
          "type": [
            "string",
            "null"
          ]
        },
        "credentialPublicKeyDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": [
            "string",
            "null"
          ]
        },
        "credentialReferenceId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "expectedArchitecture": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "expectedOs": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "expectedVersion": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "hostKey": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "inventoryDraftId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": [
            "string",
            "null"
          ]
        },
        "inventoryDraftRevision": {
          "minimum": 0,
          "type": "integer"
        },
        "materialVersion": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "port": {
          "minimum": 1,
          "type": "integer"
        },
        "profileId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "recoveryEpoch": {
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/host-discovery-target"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "targetId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "user": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "targetId",
        "revision",
        "address",
        "port",
        "user",
        "hostKey",
        "profileId",
        "credentialReferenceId",
        "materialVersion",
        "expectedOs",
        "expectedVersion",
        "expectedArchitecture",
        "inventoryDraftId",
        "inventoryDraftRevision",
        "assetId",
        "recoveryEpoch"
      ],
      "type": "object"
    },
    "host-discovery-target-draft-request": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "activate",
            "revoke"
          ],
          "type": "string"
        },
        "consoleConfirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/host-discovery-console-confirmation"
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedStateRevision": {
          "minimum": 0,
          "type": "integer"
        },
        "expectedTargetRevision": {
          "minimum": 0,
          "type": "integer"
        },
        "idempotencyKey": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/host-discovery-target-draft-request"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/host-discovery-target"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "target",
        "action",
        "expectedTargetRevision",
        "expectedStateRevision",
        "idempotencyKey"
      ],
      "type": "object"
    },
    "host-identity-confirmation": {
      "additionalProperties": false,
      "properties": {
        "confirmedAt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        "identityClass": {
          "enum": [
            "physical",
            "qualified-virtual"
          ],
          "type": "string"
        },
        "identityDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "identityKind": {
          "enum": [
            "product-serial",
            "product-uuid"
          ],
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/host-identity-confirmation"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "targetDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "targetRevision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "targetDigest",
        "targetRevision",
        "identityDigest",
        "identityClass",
        "identityKind",
        "confirmedAt"
      ],
      "type": "object"
    },
    "native-restart-presentation": {
      "additionalProperties": false,
      "properties": {
        "expectedInvocationDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "pendingDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "priorRunId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "priorStepId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/native-restart-presentation"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "priorRunId",
        "priorStepId",
        "pendingDigest",
        "expectedInvocationDigest"
      ],
      "type": "object"
    },
    "plan-binding": {
      "additionalProperties": false,
      "properties": {
        "contractVersion": {
          "pattern": "^1\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "declarationRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "observationFingerprint": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "policyVersion": {
          "pattern": "^1\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "priorStateRevision": {
          "minimum": 0,
          "type": "integer"
        },
        "reasonDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "recoveryEpoch": {
          "minimum": 0,
          "type": "integer"
        },
        "stateRevision": {
          "minimum": 1,
          "type": "integer"
        },
        "targetDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "toolVersion": {
          "maxLength": 64,
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+([0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*))?$",
          "type": "string"
        }
      },
      "required": [
        "recoveryEpoch",
        "priorStateRevision",
        "stateRevision",
        "declarationRevision",
        "observationFingerprint",
        "targetDigest",
        "reasonDigest",
        "policyVersion",
        "toolVersion",
        "contractVersion"
      ],
      "type": "object"
    },
    "plan-operation": {
      "additionalProperties": false,
      "properties": {
        "adapterId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "artifactDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "executorId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "idempotent": {
          "type": "boolean"
        },
        "inputDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "operationId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "operationType": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "targetId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "sequence",
        "operationId",
        "operationType",
        "adapterId",
        "executorId",
        "targetId",
        "inputDigest",
        "artifactDigest",
        "idempotent"
      ],
      "type": "object"
    }
  },
  "$id": "vegastack-labs.dev/plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorizationBranch": {
      "enum": [
        "human",
        "preauthorized"
      ],
      "type": "string"
    },
    "binding": {
      "$ref": "#/$defs/plan-binding"
    },
    "createdAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "declarationId": {
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
      "type": "string"
    },
    "executorId": {
      "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
      "type": [
        "string",
        "null"
      ]
    },
    "executorMode": {
      "enum": [
        "central",
        "external"
      ],
      "type": "string"
    },
    "expiresAt": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
      "type": "string"
    },
    "extensions": {
      "items": {
        "$ref": "#/$defs/contract-extension"
      },
      "maxItems": 64,
      "type": "array"
    },
    "hostAccessSequence": {
      "anyOf": [
        {
          "$ref": "#/$defs/host-access-sequence"
        },
        {
          "type": "null"
        }
      ]
    },
    "hostAction": {
      "anyOf": [
        {
          "$ref": "#/$defs/host-action-request"
        },
        {
          "type": "null"
        }
      ]
    },
    "hostActionConsole": {
      "anyOf": [
        {
          "$ref": "#/$defs/host-action-credential-confirmation"
        },
        {
          "type": "null"
        }
      ]
    },
    "hostActionNativeUnit": {
      "maxLength": 256,
      "type": "string"
    },
    "hostAdoption": {
      "anyOf": [
        {
          "$ref": "#/$defs/host-adoption-request"
        },
        {
          "type": "null"
        }
      ]
    },
    "hostDiscoveryTarget": {
      "anyOf": [
        {
          "$ref": "#/$defs/host-discovery-target-draft-request"
        },
        {
          "type": "null"
        }
