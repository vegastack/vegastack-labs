          "minimum": 0,
          "type": "integer"
        },
        "materialVersion": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "port": {
          "minimum": 1,
          "type": "integer"
        },
        "profileId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "recoveryEpoch": {
          "minimum": 0,
          "type": "integer"
        },
        "revision": {
          "minimum": 1,
          "type": "integer"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/host-discovery-target"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "targetId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "user": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
