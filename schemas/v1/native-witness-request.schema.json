          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "actionVersion": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "type": "string"
        },
        "automationPrincipalId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "bundleId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "callerUid": {
          "minimum": 1,
