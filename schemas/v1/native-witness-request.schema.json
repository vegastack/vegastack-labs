{
  "$defs": {
    "access-package": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/access-package"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "version": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "name",
        "version"
      ],
      "type": "object"
    },
    "access-probe-source": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "contextDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "contextId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "family": {
          "enum": [
            "ipv4",
            "ipv6"
          ],
          "type": "string"
        },
        "hostId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "identityDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "interface": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "interfaceIndex": {
          "minimum": 1,
          "type": "integer"
        },
        "kind": {
          "enum": [
            "host-network",
            "network-namespace",
            "container"
          ],
          "type": "string"
        },
        "routeDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/access-probe-source"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "hostId",
        "identityDigest",
        "kind",
        "contextId",
        "contextDigest",
        "interface",
        "interfaceIndex",
        "address",
        "family",
        "routeDigest"
      ],
      "type": "object"
    },
    "access-probe-tuple": {
      "additionalProperties": false,
      "properties": {
        "address": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "hostId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "identityDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "ownershipDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "port": {
          "minimum": 1,
          "type": "integer"
        },
        "protocol": {
          "enum": [
            "tcp",
            "udp"
          ],
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/access-probe-tuple"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "hostId",
        "identityDigest",
        "address",
        "port",
        "protocol"
      ],
      "type": "object"
    },
    "access-verification-evidence": {
      "additionalProperties": false,
      "properties": {
        "applyReceiptDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "expiresAt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        "probeResultsDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "rollbackRecordDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/access-verification-evidence"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "sequenceDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "applyReceiptDigest",
        "rollbackRecordDigest",
        "probeResultsDigest",
        "sequenceDigest",
        "expiresAt"
      ],
      "type": "object"
    },
    "baseline-aide-policy": {
      "additionalProperties": false,
      "properties": {
        "approvedChangeDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "previousDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "referenceDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/baseline-aide-policy"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "scopeDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "scopePaths": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "scopePaths",
        "scopeDigest"
      ],
      "type": "object"
    },
    "baseline-apparmor-profile": {
      "additionalProperties": false,
      "properties": {
        "allowedProbeSelector": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "deniedProbeSelector": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "packageName": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "profileDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "profileId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/baseline-apparmor-profile"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "profileId",
        "packageName",
        "profileDigest",
        "allowedProbeSelector",
        "deniedProbeSelector"
      ],
      "type": "object"
    },
    "baseline-kernel-setting": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "enum": [
            "kernel.dmesg_restrict",
            "kernel.kptr_restrict",
            "kernel.yama.ptrace_scope",
            "fs.protected_hardlinks",
            "fs.protected_symlinks"
          ],
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/baseline-kernel-setting"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "value": {
          "enum": [
            "1",
            "2"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "name",
        "value"
      ],
      "type": "object"
    },
    "baseline-resource-limit": {
      "additionalProperties": false,
      "properties": {
        "cpuQuotaPercent": {
          "minimum": 1,
          "type": "integer"
        },
        "memoryMaxBytes": {
          "minimum": 1,
          "type": "integer"
        },
        "minimumFreeBytes": {
          "minimum": 1,
          "type": "integer"
        },
        "minimumFreePercent": {
          "minimum": 1,
          "type": "integer"
        },
        "mountPath": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/baseline-resource-limit"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "tasksMax": {
          "minimum": 1,
          "type": "integer"
        },
        "unit": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "unit",
        "mountPath",
        "memoryMaxBytes",
        "tasksMax",
        "cpuQuotaPercent",
        "minimumFreeBytes",
        "minimumFreePercent"
      ],
      "type": "object"
    },
    "debian-baseline-input": {
      "additionalProperties": false,
      "properties": {
        "actionVersion": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "type": "string"
        },
        "aide": {
          "$ref": "#/$defs/baseline-aide-policy"
        },
        "appArmorProfiles": {
          "items": {
            "$ref": "#/$defs/baseline-apparmor-profile"
          },
          "maxItems": 16,
          "type": "array"
        },
        "auditPaths": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "automationUid": {
          "minimum": 1,
          "type": "integer"
        },
        "controlIds": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array",
          "uniqueItems": true
        },
        "hostId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "hostIdentityDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "kernelSettings": {
          "items": {
            "$ref": "#/$defs/baseline-kernel-setting"
          },
          "maxItems": 16,
          "type": "array"
        },
        "profileId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "profileLock": {
          "$ref": "#/$defs/debian-profile-lock"
        },
        "profileLockDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "recoverySourcePrefixes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "type": "array",
          "uniqueItems": true
        },
        "renderedPolicyDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/baseline-resource-limit"
          },
          "maxItems": 16,
          "type": "array"
        },
        "roleId": {
          "enum": [
            "control",
            "application",
            "ci",
            "host",
            "recovery-spare",
            "reserve"
          ],
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/debian-baseline-input"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "timeOwner": {
          "enum": [
            "systemd-timesyncd",
            "chrony"
          ],
          "type": "string"
        },
        "updateOwner": {
          "enum": [
            "unattended-upgrades",
            "apt-periodic",
            "operator"
          ],
          "type": "string"
        },
        "volumes": {
          "items": {
            "$ref": "#/$defs/host-volume-binding"
          },
          "maxItems": 16,
          "type": "array"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "hostId",
        "hostIdentityDigest",
        "profileId",
        "profileLockDigest",
        "profileLock",
        "roleId",
        "actionVersion",
        "automationUid",
        "renderedPolicyDigest",
        "controlIds",
        "recoverySourcePrefixes",
        "updateOwner",
        "timeOwner",
        "auditPaths",
        "appArmorProfiles",
        "aide",
        "resources",
        "kernelSettings",
        "volumes"
      ],
      "type": "object"
    },
    "debian-profile-lock": {
      "additionalProperties": false,
      "properties": {
        "ansibleExecutableDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "ansibleVersion": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "architecture": {
          "enum": [
            "amd64"
          ],
          "type": "string"
        },
        "backend": {
          "enum": [
            "iptables-nft"
          ],
          "type": "string"
        },
        "collectionDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "executableVersion": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(-[0-9A-Za-z.-]+)?$",
          "type": "string"
        },
        "imageDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "osFamily": {
          "enum": [
            "debian"
          ],
          "type": "string"
        },
        "osVersion": {
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "packageSourceDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "packages": {
          "items": {
            "$ref": "#/$defs/access-package"
          },
          "maxItems": 64,
          "type": "array"
        },
        "roleDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/debian-profile-lock"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "imageDigest",
        "osFamily",
        "osVersion",
        "architecture",
        "packageSourceDigest",
        "packages",
        "executableVersion",
        "ansibleVersion",
        "ansibleExecutableDigest",
        "collectionDigest",
        "roleDigest",
        "backend"
      ],
      "type": "object"
    },
    "host-action-bundle": {
      "additionalProperties": false,
