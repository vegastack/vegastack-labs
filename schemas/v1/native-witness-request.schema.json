              "type": "null"
            }
          ]
        },
        "verificationEvidenceDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "actionId",
        "actionVersion",
        "actionInputDigest",
        "actionInput",
        "bundleId",
        "planId",
        "runId",
        "stepId",
        "leaseId",
        "hostId",
        "declarationId",
        "automationPrincipalId",
        "credentialReferenceId",
        "credentialMaterialVersion",
        "planDigest",
        "hostIdentityDigest",
        "consoleConfirmationDigest",
        "declarationRevision",
        "stateRevision",
        "recoveryEpoch",
        "callerUid",
        "issuedAt",
        "expiresAt"
      ],
      "type": "object"
    },
