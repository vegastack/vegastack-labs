        "schemaVersion",
        "targetId",
        "revision",
        "address",
        "port",
        "user",
        "hostKey",
        "profileId",
        "credentialReferenceId",
        "materialVersion",
        "expectedOs",
        "expectedVersion",
        "expectedArchitecture",
        "inventoryDraftId",
        "inventoryDraftRevision",
        "assetId",
        "recoveryEpoch"
      ],
      "type": "object"
    },
    "host-volume-binding": {
      "additionalProperties": false,
      "properties": {
        "controlHostId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
