    "access-rollback-specification": {
      "additionalProperties": false,
      "properties": {
        "deadlineSeconds": {
          "maximum": 600,
          "minimum": 600,
          "type": "integer"
        },
        "hostId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "hostIdentityDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "ownedState": {
          "items": {
            "$ref": "#/$defs/access-owned-state"
          },
          "maxItems": 64,
          "type": "array"
        },
        "profileLockDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "recoverySourcePrefixes": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/access-rollback-specification"
