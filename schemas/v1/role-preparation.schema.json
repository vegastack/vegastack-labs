          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "hostId",
        "hostIdentityDigest",
        "profileLockDigest",
        "ownedState",
        "deadlineSeconds",
        "recoverySourcePrefixes"
      ],
      "type": "object"
