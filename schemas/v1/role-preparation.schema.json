    "access-service-key": {
      "additionalProperties": false,
      "properties": {
        "publicKey": {
          "maxLength": 2048,
          "minLength": 1,
          "type": "string"
        },
        "publicKeyDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
