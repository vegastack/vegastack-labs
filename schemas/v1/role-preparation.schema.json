        },
        "index": {
          "minimum": 1,
          "type": "integer"
        },
        "ipv6Enabled": {
          "type": "boolean"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/access-interface"
          ],
