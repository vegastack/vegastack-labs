        "foregroundStartIdentity": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "recoveryEpoch": {
          "minimum": 0,
          "type": "integer"
        },
        "rollbackDeadline": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/control-handoff-input"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "serviceUid": {
          "minimum": 1,
          "type": "integer"
        },
        "socketIdentityDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "unitDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "writerLockDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        }
