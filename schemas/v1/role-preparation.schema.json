{
  "$defs": {
    "access-account": {
      "additionalProperties": false,
      "properties": {
        "gid": {
          "minimum": 1,
          "type": "integer"
        },
        "home": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "publicKeyDigests": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array",
          "uniqueItems": true
        },
        "publicKeys": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "type": "array",
          "uniqueItems": true
        },
        "role": {
          "enum": [
            "human",
            "automation",
            "service"
          ],
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/access-account"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "uid": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "name",
        "uid",
        "gid",
        "home",
        "role",
        "publicKeys",
        "publicKeyDigests"
      ],
      "type": "object"
    },
    "access-flow": {
      "additionalProperties": false,
      "properties": {
        "destinationPrefix": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        "interface": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "port": {
          "minimum": 1,
          "type": "integer"
        },
        "protocol": {
          "enum": [
            "tcp",
            "udp"
          ],
          "type": "string"
        },
        "schema": {
          "enum": [
            "vegastack-labs.dev/access-flow"
          ],
          "type": "string"
        },
        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "sourcePrefix": {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "protocol",
        "sourcePrefix",
        "destinationPrefix",
        "port",
        "interface"
