        "schemaVersion": {
          "enum": [
            "1.0.0"
          ],
          "type": "string"
        },
        "serviceId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "sourcePrefixes": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "type": "array",
          "uniqueItems": true
