      "required": [
        "schema",
        "schemaVersion",
        "foregroundPid",
        "foregroundStartIdentity",
        "serviceUid",
        "databaseInstanceId",
        "recoveryEpoch",
        "writerLockDigest",
        "unitDigest",
        "configDigest",
        "executableDigest",
        "socketIdentityDigest",
        "expiresAt",
        "rollbackDeadline"
      ],
      "type": "object"
