      "required": [
        "schema",
        "schemaVersion",
        "serviceId",
        "publicKey",
        "publicKeyDigest",
        "sourcePrefixes"
      ],
      "type": "object"
    },
    "control-handoff-input": {
      "additionalProperties": false,
      "properties": {
        "configDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "databaseInstanceId": {
          "pattern": "^[a-z][a-z0-9._:-]{0,127}$",
          "type": "string"
        },
        "executableDigest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "expiresAt": {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
          "type": "string"
