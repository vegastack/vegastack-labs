[Unit]
Description=Restore interrupted VegaStack access change before network services
DefaultDependencies=no
After=local-fs.target apparmor.service
Before=network-pre.target ssh.service ssh.socket docker.service
[Service]
Type=oneshot
ExecStart=/usr/local/bin/vsk-labs access-rollback
User=root
Group=root
UMask=0077
[Install]
WantedBy=sysinit.target
RequiredBy=ssh.service docker.service
