{
  "name": "vegastack-labs",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.24.0"
  },
  "scripts": {
    "check": "node tooling/check.mjs",
    "check:cli": "node tooling/verify-cli.mjs",
    "check:contracts": "go run ./tooling/generate-contracts --check",
    "check:dependencies": "node tooling/provenance.mjs --check",
    "check:docs": "node tooling/verify-docs.mjs",
    "check:go-dependencies": "node tooling/verify-go-dependencies.mjs --check",
    "check:historical": "node tooling/historical.mjs --check",
    "check:phase-0-3": "node tooling/verify-phase-0-3.mjs",
    "check:phase-0-4": "node tooling/verify-phase-0-4.mjs",
    "check:phase-0-5": "node tooling/verify-phase-0-5.mjs",
    "check:phase-2": "node tooling/verify-phase-2.mjs",
    "check:read-api": "node tooling/verify-read-api.mjs",
    "check:repository": "node tooling/verify-repository.mjs",
    "check:server": "node tooling/verify-server.mjs",
    "check:workflow": "node tooling/verify-workflow.mjs",
    "generate:historical": "node tooling/historical.mjs --write --approve-current",
    "generate:go-provenance": "node tooling/verify-go-dependencies.mjs --propose",
    "generate:contracts": "go run ./tooling/generate-contracts --write",
    "generate:provenance": "node tooling/provenance.mjs --write --approve-current-lock",
    "test:tooling": "node --test tooling/test/*.test.mjs"
  },
  "devDependencies": {
    "spdx-expression-parse": "5.0.0",
    "yaml": "2.9.0"
  }
}
